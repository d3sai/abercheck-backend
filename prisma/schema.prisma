generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  AWAITING_PAYMENT
  PARTIALLY_PAID
  UNDERPAID
  PAID
  OVERPAID
  CANCELLED

  @@map("order_status")
}

enum OrderType {
  REGULAR
  MINUS_CLOSING
  REQUISITES

  @@map("order_type")
}

enum Currency {
  UAH
  USD
  EUR

  @@map("currency")
}

enum MatchType {
  MATCHED_BY_PROVIDER
  MANUAL

  @@map("match_type")
}

enum RefundType {
  FULL
  PARTIAL

  @@map("refund_type")
}

enum ManagerStatus {
  PENDING
  ACTIVE
  REJECTED

  @@map("manager_status")
}

enum ManagerRole {
  ADMIN
  MANAGER

  @@map("manager_role")
}

model Manager {
  id             Int           @id @default(autoincrement())
  telegramId     BigInt        @unique @map("telegram_id")
  name           String
  username       String?
  status         ManagerStatus @default(PENDING)
  role           ManagerRole   @default(MANAGER)
  login          String?       @unique
  passwordHash   String?       @map("password_hash")
  sessionVersion Int           @default(0) @map("session_version")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  orders       Order[]
  requestCards FinanceRequestCard[]

  @@map("managers")
}

model Order {
  id             Int         @id @default(autoincrement())
  orderNumber    String      @unique @map("order_number")
  baseNumber     String      @map("base_number")
  clientName     String      @map("client_name")
  amountDue      Decimal     @map("amount_due") @db.Decimal(14, 2)
  currency       Currency    @default(UAH)
  exchangeRate   Decimal?    @map("exchange_rate") @db.Decimal(8, 4)
  comment        String?
  // Retired: was free text for a "payment to other requisites" order type. No longer written by the
  // app; kept only because it may already exist as a column in some environments. See OrderRequisite.
  requisites     String?
  orderType      OrderType   @default(REGULAR) @map("order_type")
  // Minus closing only: when the client paid, which of our FOPs received it, the period the debt
  // was calculated for, and the reconciliation spreadsheet.
  paidAt         DateTime?   @map("paid_at") @db.Timestamptz(3)
  ourFop         String?     @map("our_fop")
  period         String?
  sheetUrl       String?     @map("sheet_url")
  status         OrderStatus @default(AWAITING_PAYMENT)
  managerId      Int         @map("manager_id")
  // The "new order" message in the admin chat, kept so it can be removed along with the order.
  adminMessageId Int?        @map("admin_message_id")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  manager        Manager             @relation(fields: [managerId], references: [id], onDelete: Restrict)
  payments       Payment[]
  refunds        Refund[]
  amountChanges  OrderAmountChange[]
  attachments    OrderAttachment[]
  paymentDetails OrderRequisite[]

  @@index([status])
  @@index([managerId])
  @@index([baseNumber])
  @@map("orders")
}

// One individual payment that made up an order's total, when it was paid via someone else's
// requisites (cards, other people's FOPs) rather than a single matched bank transfer: who actually
// paid, through which requisites, how much, and when. Purely supporting evidence for reconciliation —
// the order itself is created and paid exactly like any other.
model OrderRequisite {
  id                Int      @id @default(autoincrement())
  orderId           Int      @map("order_id")
  payerName         String   @map("payer_name")
  account           String?
  amount            Decimal  @db.Decimal(14, 2)
  paidAt            DateTime @map("paid_at") @db.Timestamptz(3)
  addedByTelegramId BigInt   @map("added_by_telegram_id")
  addedByName       String   @map("added_by_name")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_requisites")
}

model Payment {
  id                    Int       @id @default(autoincrement())
  externalTransactionId String    @unique @map("external_transaction_id")
  amount                Decimal   @db.Decimal(14, 2)
  currency              Currency  @default(UAH)
  payerName             String?   @map("payer_name")
  receivingAccount      String?   @map("receiving_account")
  purposeText           String?   @map("purpose_text")
  paidAt                DateTime  @map("paid_at") @db.Timestamptz(3)
  reportedOrderNumber   String?   @map("reported_order_number")
  orderId               Int?      @map("order_id")
  matchType             MatchType @map("match_type")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([paidAt])
  @@map("payments")
}

model Refund {
  id                    Int        @id @default(autoincrement())
  orderId               Int        @map("order_id")
  amount                Decimal    @db.Decimal(14, 2)
  type                  RefundType
  initiatedByTelegramId BigInt     @map("initiated_by_telegram_id")
  initiatedByName       String     @map("initiated_by_name")
  note                  String?
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("refunds")
}

model OrderAmountChange {
  id                  Int      @id @default(autoincrement())
  orderId             Int      @map("order_id")
  previousAmountDue   Decimal  @map("previous_amount_due") @db.Decimal(14, 2)
  newAmountDue        Decimal  @map("new_amount_due") @db.Decimal(14, 2)
  changedByTelegramId BigInt   @map("changed_by_telegram_id")
  changedByName       String   @map("changed_by_name")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_amount_changes")
}

model OrderAttachment {
  id                   Int      @id @default(autoincrement())
  orderId              Int      @map("order_id")
  filename             String
  mimeType             String   @map("mime_type")
  size                 Int
  telegramFileId       String   @map("telegram_file_id")
  telegramMessageId    Int      @map("telegram_message_id")
  keepMessageOnDelete  Boolean  @default(false) @map("keep_message_on_delete")
  uploadedByTelegramId BigInt   @map("uploaded_by_telegram_id")
  uploadedByName       String   @map("uploaded_by_name")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_attachments")
}

model TelegramLoginHash {
  hash      String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("telegram_login_hashes")
}

model FinanceRequestCard {
  requestId        String    @id @map("request_id")
  number           String
  managerId        Int       @map("manager_id")
  managerChatId    BigInt    @map("manager_chat_id")
  managerMessageId Int?      @map("manager_message_id")
  groupChatId      BigInt    @map("group_chat_id")
  groupMessageId   Int       @map("group_message_id")
  pendingRate      String?   @map("pending_rate")
  notifiedStatus   String?   @map("notified_status")
  // Set atomically when the manager completes the request; orderIds are the orders it created.
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(3)
  orderIds         Int[]     @default([]) @map("order_ids")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  manager Manager              @relation(fields: [managerId], references: [id])
  files   FinanceRequestFile[]

  @@unique([groupChatId, groupMessageId])
  @@index([managerChatId, managerMessageId])
  @@map("finance_request_cards")
}

// A receipt the manager sent in the bot chat before completing the request; it is attached to the
// created order at completion and the row is deleted.
model FinanceRequestFile {
  id        Int      @id @default(autoincrement())
  requestId String   @map("request_id")
  fileId    String   @map("file_id")
  filename  String
  mimeType  String   @map("mime_type")
  size      Int
  kind      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  request FinanceRequestCard @relation(fields: [requestId], references: [requestId], onDelete: Cascade)

  @@index([requestId])
  @@map("finance_request_files")
}

model FinanceMessageSeen {
  messageId String   @id @map("message_id")
  seenAt    DateTime @default(now()) @map("seen_at") @db.Timestamptz(3)

  @@map("finance_messages_seen")
}

// Bot messages the manager can reply to: telegram does not nest `reply_to_message`, so the request must be remembered.
model FinanceChatMessage {
  chatId    BigInt   @map("chat_id")
  messageId Int      @map("message_id")
  requestId String   @map("request_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([chatId, messageId])
  @@map("finance_chat_messages")
}
