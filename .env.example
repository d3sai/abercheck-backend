NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

EXTERNAL_API_KEY=""

# Key for /admin routes (aber-tools). 32+ chars, must differ from EXTERNAL_API_KEY. Empty disables them.
ADMIN_API_KEY=""

TELEGRAM_BOT_TOKEN=""

TELEGRAM_ADMIN_CHAT_ID=""

WEB_JWT_SECRET=""

# Optional: forum topic ids (message_thread_id) of the admin group. Empty = plain chat.
TELEGRAM_TOPIC_REQUESTS_ID=""
TELEGRAM_TOPIC_PAYMENTS_ID=""
TELEGRAM_TOPIC_REPORTS_ID=""

# Optional: Telegram id of the first admin. With no managers yet only this id can become one; empty = whoever logs in first.
BOOTSTRAP_ADMIN_TELEGRAM_ID=""

# Optional: secret (16+ chars) shared with the cabinet (CLIENT_IP_TOKEN there). Set on both, then the login rate limit
# believes X-Client-IP only from the cabinet; unset, anyone can forge it.
CLIENT_IP_TOKEN=""

# Optional: finance sync. Empty URL disables it; with a URL both tokens (16+ chars) are required.
# FINANCE_API_URL includes the finance API prefix, e.g. https://finance.example.ua/api/v1
# Finance must call https://<this host>/api/finance/webhook (ABERCHECK_WEBHOOK_URL in finance), with FINANCE_WEBHOOK_TOKEN.
FINANCE_API_URL=""
FINANCE_API_TOKEN=""
FINANCE_WEBHOOK_TOKEN=""

# Optional: the Mini App request form (https only). Empty hides its bot buttons.
MINI_APP_URL=https://<cabinet-domain>/tg/request
